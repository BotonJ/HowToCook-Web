# CSP single source of truth: API hosts are
#   - https://api.howtocook.cn      (production, API_BASE default)
#   - https://api-preview.howtocook.cn  (preview deployments, VITE_API_BASE)
# (= src/services/api.ts API_BASE). Every connect-src block below MUST include
# both. If you change the host, update all blocks + API_BASE in lockstep.
# Cloudflare Pages replaces (does not merge) header values per more-specific
# path, so the /explore/* block needs its own copy despite the /* block above.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; worker-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.howtocook.cn https://api-preview.howtocook.cn; frame-ancestors 'none'

# Keep in sync with the /* connect-src above (same API hosts).
# Note: /explore currently reads only same-origin /data/* files, but the API
# host is allowed here so a future API call from Explore won't be CSP-blocked.
/explore/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self' 'unsafe-inline' 'unsafe-eval'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.howtocook.cn https://api-preview.howtocook.cn; frame-ancestors 'self'

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.json
  Content-Type: application/manifest+json
  Cache-Control: no-cache

/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Binary embedding/vector assets are content-addressed (never change in place):
# cache them aggressively to cut the ~13MB Explore payload on repeat visits.
/data/*.f32
  Cache-Control: public, max-age=31536000, immutable

# JSON indices may be regenerated; revalidate periodically.
/data/*
  Cache-Control: public, max-age=3600, must-revalidate
