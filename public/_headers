# CSP single source of truth: API hosts are
#   - https://api.howtocook.cn      (production, API_BASE default)
#   - https://api-preview.howtocook.cn  (preview deployments, VITE_API_BASE)
# (= src/services/api.ts API_BASE). Every connect-src block below MUST include
# both. If you change the host, update all blocks + API_BASE in lockstep.
# Cloudflare Pages replaces (does not merge) header values per more-specific
# path, so the /explore/* block needs its own copy despite the /* block above.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; frame-src https://challenges.cloudflare.com; worker-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.howtocook.cn https://api-preview.howtocook.cn https://cloudflareinsights.com; frame-ancestors 'none'

# Keep in sync with the /* connect-src above (same API hosts).
# Note: /explore renders FlavorWorkbench, which now reads from the API
# (/flavor/workbench, /flavor/npmi-graph); the API host is allowed here.
/explore/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.howtocook.cn https://api-preview.howtocook.cn https://cloudflareinsights.com; frame-ancestors 'self'

# Entry HTML must always revalidate so new deploys (with new asset hashes)
# are picked up immediately. Without this, a stale cached index.html keeps
# referencing old hashes, or a freshly-deployed one hits a CDN edge that
# hasn't propagated the new asset yet → SPA fallback returns HTML → MIME
# error on module scripts. Hashed assets (/assets/*) stay immutable below.
/index.html
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/manifest.json
  Content-Type: application/manifest+json
  Cache-Control: no-cache

/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# JSON indices may be regenerated; revalidate periodically.
/data/*
  Cache-Control: public, max-age=3600, must-revalidate
